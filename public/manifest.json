{
  "action": {
    "default_popup": "index.html",
    "default_title": "Change Wallet"
  },
  "background": {
    "service_worker": "./static/js/background.js"
  },
  "content_scripts": [{
    "all_frames": true,
    "js": ["./static/js/content.js"],
    "matches": ["http://*/*", "https://*/*"],
    "run_at": "document_start"
  }],
  "description": "Temporarily present a selected wallet address to dApps during local testing.",
  "icons": {
    "128": "logo.png",
    "16": "logo.png",
    "48": "logo.png"
  },
  "manifest_version": 3,
  "name": "Change Wallet",
  "permissions": ["activeTab", "tabs", "scripting", "storage", "webNavigation"],
  "version": "1.0",
  "web_accessible_resources": [{
    "matches": ["http://*/*", "https://*/*"],
    "resources": ["static/js/inpage.js"]
  }]
}
